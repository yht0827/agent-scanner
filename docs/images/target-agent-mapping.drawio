        <!-- Col 1: 정상 업무 -->
        <mxCell id="col1" value="&lt;b style=&quot;color:#059669; font-size:10.5px;&quot;&gt;정상 업무 (Baseline)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#047857; font-family:monospace; font-size:11px;&quot;&gt;searchProduct()&lt;/b&gt;&lt;br&gt;&lt;br&gt;▼&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#065F46; font-size:11px;&quot;&gt;상품 카탈로그 DB&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#059669; font-size:10px;&quot;&gt;PASS (정상 허용)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=1.5;arcSize=10;align=center;" vertex="1" parent="1">
