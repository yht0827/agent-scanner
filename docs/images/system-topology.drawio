        <!-- Target to DB2 edge -->
        <mxCell id="edge_query" value="JDBC 실전 RDBMS &amp; RAG 지식베이스 쿼리 (targetdb)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#94A3B8;fontColor=#64748B;fontSize=11px;" edge="1" parent="1" source="target" target="db2">
